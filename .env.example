# Postgres connection. Point this at a local install or a free-tier hosted instance
# (Neon/Supabase/Railway all have $0 tiers). See docker-compose.yml for a local option.
DATABASE_URL=postgresql+psycopg2://scout:scout@localhost:5433/scout

# NOT the same as an api.data.gov key -- SAM.gov's Opportunities API requires a key
# issued from SAM.gov's own Account Details page (Public API Key field), which needs a
# free SAM.gov account. api.data.gov keys look similar but return 404 on this endpoint --
# confirmed by testing. Get it at: https://sam.gov -> sign in / register -> Account Details
# -> "Public API Key" (shown once; if you didn't save it, regenerate it there).
SAM_GOV_API_KEY=

# Which Claude Code session/run this is, for the agent_events audit trail.
# Left blank, a UUID is generated per run.
SCOUT_SESSION_ID=

# Email outreach (ARCHITECTURE.md §3.6/§3.7). SMTP_PASSWORD is a Gmail App Password, NOT
# your account password -- Gmail requires this for SMTP when 2FA is on. Generate one at
# https://myaccount.google.com/apppasswords (needs 2FA enabled on the account first).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# Pin this once real sending starts, so the warmup ramp (5/day -> 40/day over ~4 weeks,
# see ratelimit/budget.py) doesn't silently reset. Format: YYYY-MM-DD. Left blank, it
# defaults to "today" every time -- fine for testing, not for real use.
EMAIL_WARMUP_START_DATE=

# Reply watching (ARCHITECTURE.md §3.8). Same Gmail account as SMTP -- the same App
# Password works for IMAP too, no separate one to generate.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
